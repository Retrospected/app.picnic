{
  "name": "app.picnic",
  "version": "3.8.3",
  "description": "Doing your groceries at Picnic via Homey.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "lint": "editorconfig-checker",
    "validate": "tsx scripts/validate.ts",
    "deps": "node scripts/deps.js",
    "prestart": "node scripts/deps.js",
    "start": "homey app run",
    "prestart:clean": "node scripts/deps.js",
    "start:clean": "homey app run --clean",
    "preinstall:homey": "node scripts/deps.js",
    "install:homey": "homey app install",
    "compose": "homey app compose",
    "gallery": "tsx scripts/widget-gallery.ts",
    "previews": "tsx scripts/previews.ts",
    "prevalidate:cli": "node scripts/deps.js",
    "validate:cli": "homey app validate --level publish"
  },
  "dependencies": {
    "md5": "^2.2.1",
    "node-schedule": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retrospected/app.picnic.git"
  },
  "keywords": [
    "picnic",
    "Homey",
    "app"
  ],
  "author": "Sander Maas",
  "license": "GNU version 3",
  "bugs": {
    "url": "https://github.com/Retrospected/app.picnic/issues"
  },
  "homepage": "https://github.com/Retrospected/app.picnic#readme",
  "devDependencies": {
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/md5": "^2.3.6",
    "@types/node": "^22.20.5",
    "@types/node-schedule": "^2.1.8",
    "editorconfig-checker": "^6.2.0",
    "homey-lib": "^2.52.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
