# The formatting every editor in this repository agrees on, whichever one you
# use: https://editorconfig.org. Most editors read it out of the box, the rest
# have a plugin. `npm run lint` checks these same rules, so what it says here
# is also what CI enforces.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Make reads a tab as the start of a recipe line, so it has no say in this.
[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

# Generated by the Homey CLI, which decides how it ends.
[app.json]
insert_final_newline = unset

# Third party files, kept as their authors shipped them.
[settings/{angular.js,bootstrap.css,smart-table.min.js}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
