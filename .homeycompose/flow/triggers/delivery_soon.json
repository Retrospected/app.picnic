{
    "id": "delivery_soon",
    "title": {
      "en": "Groceries will be delivered soon",
      "nl": "Boodschappen worden binnenkort geleverd"
    },
    "titleFormatted": {
      "en": "Groceries will be delivered in [[minutes]] minutes",
      "nl": "Boodschappen worden over [[minutes]] minuten bezorgd"
    },
    "hint": {
      "en": "Triggers the configured number of minutes before the start of the delivery window.",
      "nl": "Vuurt het ingestelde aantal minuten vóór het begin van het bezorgvenster."
    },
    "args": [
      {
        "name": "minutes",
        "type": "number",
